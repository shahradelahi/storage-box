{
  "name": "storage-box",
  "version": "1.0.3",
  "description": "A memory-based key–value storage for javascript.",
  "keywords": [
    "storage",
    "key-value",
    "memory",
    "browser",
    "nodejs",
    "litehex"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shahradelahi/storage-box.git"
  },
  "license": "MIT",
  "author": "Shahrad Elahi <shahrad@litehex.com> (https://github.com/shahradelahi)",
  "contributors": [
    "Seven Du <shiweidu@outlook.com> (https://github.com/medz)"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "./dist",
  "typesVersions": {
    "*": {
      "node": [
        "dist/node.d.cts",
        "dist/node.d.ts"
      ],
      "browser": [
        "dist/browser.d.cts",
        "dist/browser.d.ts"
      ]
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup",
    "ci:publish": "changeset publish",
    "clean": "git clean -dfx node_modules dist .tsbuildinfo",
    "dev": "tsup --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm typecheck && eslint .",
    "lint:fix": "eslint --fix .",
    "prepublishOnly": "pnpm build && pnpm lint && pnpm format:check && pnpm test",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@shahrad/prettier-config",
  "dependencies": {
    "@se-oss/msgpack": "^1.0.0",
    "debounce": "^2.1.0",
    "exit-hook": "^4.0.0",
    "type-fest": "^4.26.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@shahrad/eslint-config": "^1.1.0",
    "@shahrad/prettier-config": "^1.2.2",
    "@shahrad/tsconfig": "^1.3.0",
    "@types/node": "^25.9.9",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "publishConfig": {
    "access": "public"
  }
}
